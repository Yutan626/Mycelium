# Copy this file to `.env` and fill in your LOCAL values.
# Never commit `.env` or any real secrets to Git.
DJANGO_SECRET_KEY=replace-with-a-local-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost
# Database engine: "sqlite" (default, no server needed, uses backend/db.sqlite3)
# or "postgresql" (production on Render, plus the POSTGRES_* values below).
DB_ENGINE=sqlite
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=
POSTGRES_PORT=5432
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
FRONTEND_ORIGIN=http://127.0.0.1:5500
# --- Production only (Render dashboard, never commit values) ---
# DJANGO_SECURE=1
# CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=you@gmail.com
# EMAIL_HOST_PASSWORD=your-gmail-app-password
# DEFAULT_FROM_EMAIL=Mycelium <you@gmail.com>
